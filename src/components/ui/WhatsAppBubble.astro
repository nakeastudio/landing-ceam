---
import { Icon } from 'astro-icon/components';

const waHref = 'https://wa.me/59169816519?text=Hola%20MENTOR%20CEAM';
---
<div
  id="wa-bubble-root"
  class="fixed right-6 sm:right-10 z-50 flex flex-col items-end gap-3"
  style="bottom: calc(env(safe-area-inset-bottom, 0px) + 2rem);"
  data-wa-root
>
  {/* Preview message card */}
  <div
    id="wa-bubble-preview"
    class="wa-preview pointer-events-none opacity-0 translate-y-4 scale-95 transition-[opacity,transform] duration-[400ms] ease-[cubic-bezier(0.22,1,0.36,1)] relative max-w-[280px] w-[280px] rounded-2xl bg-white border border-[var(--color-border)] shadow-[0_20px_50px_-15px_rgba(4,44,83,0.25)] p-4 pr-9"
    role="dialog"
    aria-label="Mensaje rápido de WhatsApp"
    data-wa-preview
  >
    <button
      type="button"
      class="absolute top-2 right-2 grid h-6 w-6 place-items-center rounded-full text-[var(--color-fg-subtle)] hover:bg-[var(--color-bg-secondary)] hover:text-[var(--color-fg)] transition-colors"
      aria-label="Cerrar mensaje"
      data-wa-close
    >
      <Icon name="tabler:x" class="h-3.5 w-3.5" />
    </button>

    <a
      href={waHref}
      target="_blank"
      rel="noopener"
      class="block focus:outline-none focus-visible:ring-2 focus-visible:ring-[#25D366] rounded-lg"
    >
      <div class="flex items-center gap-2.5">
        <div class="relative h-9 w-9 shrink-0">
          <img
            src="/assets/chatbot.png"
            alt="MENTOR CEAM"
            class="h-9 w-9 rounded-full object-cover bg-white ring-1 ring-[var(--color-border)]"
            width="36"
            height="36"
          />
          <span class="absolute -bottom-0.5 -right-0.5 h-2.5 w-2.5 rounded-full bg-[#22C55E] ring-2 ring-white"></span>
        </div>
        <div class="min-w-0">
          <p class="font-display font-bold text-[13px] text-[var(--color-fg)] leading-tight tracking-wide">
            MENTOR CEAM
          </p>
          <p class="flex items-center gap-1 text-[10.5px] text-[#22C55E] font-medium leading-tight mt-0.5">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-[#22C55E]"></span>
            En línea
          </p>
        </div>
      </div>
      <p class="mt-2.5 text-[13.5px] leading-snug text-[var(--color-fg-muted)]">
        ¿Tienes dudas? Escribenos por WhatsApp
      </p>
    </a>

    {/* Tail pointing down-right toward the button */}
    <span
      aria-hidden="true"
      class="absolute -bottom-1.5 right-6 h-3 w-3 rotate-45 bg-white border-r border-b border-[var(--color-border)]"
    ></span>
  </div>

  {/* Main button */}
  <a
    id="wa-bubble-btn"
    href={waHref}
    target="_blank"
    rel="noopener"
    aria-label="Abrir chat de WhatsApp con MENTOR CEAM"
    class="wa-btn group relative grid h-[60px] w-[60px] sm:h-[68px] sm:w-[68px] place-items-center rounded-full bg-[#25D366] text-white shadow-[0_18px_40px_-10px_rgba(37,211,102,0.55)] transition-transform duration-200 hover:scale-[1.08] focus:outline-none focus-visible:ring-4 focus-visible:ring-[#25D366]/40 opacity-0 translate-y-5"
    data-wa-btn
  >
    <span aria-hidden="true" class="wa-ring absolute inset-0 rounded-full"></span>
    <Icon name="tabler:brand-whatsapp" class="relative h-7 w-7 sm:h-8 sm:w-8" />
  </a>
</div>

<style>
  .wa-btn {
    animation: waFadeUp 600ms cubic-bezier(0.22, 1, 0.36, 1) 200ms forwards;
  }
  @keyframes waFadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes pulseRingGreen {
    0%   { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5); }
    70%  { box-shadow: 0 0 0 14px rgba(37, 211, 102, 0); }
    100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
  }
  .wa-ring {
    animation: pulseRingGreen 2.4s ease-out infinite;
  }

  .wa-preview.is-open {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  /* Bigger breathing room on tablet/desktop where the viewport is taller */
  @media (min-width: 640px) {
    #wa-bubble-root {
      bottom: calc(env(safe-area-inset-bottom, 0px) + 2.5rem) !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-btn {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .wa-ring {
      animation: none;
    }
    .wa-preview {
      transition: none;
    }
  }
</style>
