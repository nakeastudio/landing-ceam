---
import { Icon } from 'astro-icon/components';
import SectionHeader from '../ui/SectionHeader.astro';
import Reveal from '../ui/Reveal.astro';
import { audiences } from '../../lib/content';

const defaultIndex = Math.max(0, audiences.findIndex((a) => a.highlighted));
---
<section id="para-quien" class="relative py-20 sm:py-28 bg-[var(--color-bg-secondary)]">
  <div class="container-page">
    <div class="grid lg:grid-cols-[1fr_1.3fr] gap-10 lg:gap-16 items-start">
      <div class="lg:sticky lg:top-28">
        <SectionHeader
          eyebrow="¿Para quién es?"
          eyebrowColor="blue"
          title="Diseñado para cada etapa de la formación médica"
          accentWord="cada etapa"
          align="left"
        />
        <p class="mt-6 text-base leading-relaxed text-[var(--color-fg-muted)] max-w-md">
          Elegí tu etapa y descubrí cómo CEAM se adapta a lo que estás estudiando ahora.
        </p>
      </div>

      <Reveal>
        <div
          class="relative rounded-3xl bg-white border border-[var(--color-border)] shadow-[0_30px_60px_-30px_rgba(15,23,42,0.18)] overflow-hidden"
          data-audience-root
        >
          {audiences.map((a, i) => (
            <div
              class="px-7 sm:px-10 py-10 sm:py-12 transition-opacity duration-300 data-[active=false]:hidden"
              data-audience-panel
              data-index={i}
              data-active={i === defaultIndex ? 'true' : 'false'}
            >
              <div class="flex items-start gap-5">
                <div class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-[var(--color-brand-50)] text-[var(--color-brand-500)]">
                  <Icon name={a.icon} class="h-7 w-7" />
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex flex-wrap items-center gap-3">
                    <h3 class="font-display font-bold text-2xl text-[var(--color-fg)] leading-tight">{a.title}</h3>
                    {a.highlighted && (
                      <span class="inline-flex items-center gap-1 rounded-full bg-[var(--color-brand-500)] text-white text-[10px] font-bold uppercase tracking-[0.16em] px-2.5 py-1">
                        Más popular
                      </span>
                    )}
                  </div>
                  <p class="mt-3 text-base leading-relaxed text-[var(--color-fg-muted)]">{a.description}</p>
                </div>
              </div>

              <div class="mt-8 pt-6 border-t border-[var(--color-border)]">
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--color-fg-muted)] mb-4">
                  Lo que vas a poder estudiar
                </p>
                <ul class="flex flex-wrap gap-2">
                  {a.subjects.map((s) => (
                    <li class="inline-flex items-center gap-1.5 rounded-full bg-[var(--color-brand-50)] text-[var(--color-brand-700)] text-sm font-medium px-3.5 py-1.5">
                      <Icon name="tabler:check" class="h-3.5 w-3.5" />
                      {s}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}

          <div class="px-3 sm:px-4 pb-4 sm:pb-5 pt-1 border-t border-[var(--color-border)] bg-[var(--color-bg-secondary)]/40">
            <div
              role="tablist"
              aria-label="Etapas de formación"
              class="flex gap-1.5 overflow-x-auto scroll-smooth snap-x snap-mandatory -mx-1 px-1 py-3 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
              data-audience-tablist
            >
              {audiences.map((a, i) => (
                <button
                  type="button"
                  role="tab"
                  data-audience-tab
                  data-index={i}
                  aria-selected={i === defaultIndex ? 'true' : 'false'}
                  class="group snap-start shrink-0 inline-flex items-center gap-2 rounded-xl border px-4 py-2.5 text-sm font-semibold transition-all duration-200 aria-selected:bg-[var(--color-brand-500)] aria-selected:text-white aria-selected:border-[var(--color-brand-500)] aria-selected:shadow-[0_10px_24px_-12px_rgba(24,95,165,0.55)] aria-[selected=false]:bg-white aria-[selected=false]:text-[var(--color-fg)] aria-[selected=false]:border-[var(--color-border)] aria-[selected=false]:hover:border-[var(--color-brand-300)] aria-[selected=false]:hover:text-[var(--color-brand-700)]"
                >
                  <Icon name={a.icon} class="h-4 w-4" />
                  <span>{a.shortLabel}</span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </Reveal>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-audience-root]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-audience-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-audience-panel]'));

    const activate = (index: number) => {
      tabs.forEach((t) => {
        const i = Number(t.dataset.index);
        t.setAttribute('aria-selected', i === index ? 'true' : 'false');
        if (i === index) t.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      });
      panels.forEach((p) => {
        const i = Number(p.dataset.index);
        p.setAttribute('data-active', i === index ? 'true' : 'false');
      });
    };

    tabs.forEach((t) => {
      t.addEventListener('click', () => activate(Number(t.dataset.index)));
    });

    root.addEventListener('keydown', (e) => {
      if (!(e.target instanceof HTMLElement) || !e.target.matches('[data-audience-tab]')) return;
      const current = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        const next = (current + 1) % tabs.length;
        activate(next);
        tabs[next].focus();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        const prev = (current - 1 + tabs.length) % tabs.length;
        activate(prev);
        tabs[prev].focus();
      }
    });
  }
</script>
