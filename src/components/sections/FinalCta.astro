---
import { Icon } from 'astro-icon/components';
import Button from '../ui/Button.astro';
import Reveal from '../ui/Reveal.astro';
---
<section id="cta" class="relative bg-[var(--color-bg-dark)] text-white overflow-hidden">
  {/* Subtle radial grid background */}
  <div
    class="absolute inset-0 opacity-[0.06] pointer-events-none"
    style="background-image: radial-gradient(circle, rgba(255,255,255,0.6) 1px, transparent 1px); background-size: 28px 28px;"
    aria-hidden="true"
  ></div>

  {/* Soft top-down gradient to add depth without manchas */}
  <div
    class="absolute inset-x-0 top-0 h-[400px] pointer-events-none"
    style="background: radial-gradient(ellipse at top, rgba(133,183,235,0.18) 0%, transparent 65%);"
    aria-hidden="true"
  ></div>

  {/* Aspirational banner — donde te lleva tu carrera */}
  <Reveal>
    <div class="relative w-full h-[260px] sm:h-[360px] overflow-hidden">
      <img
        src="/assets/team-surgery.webp"
        alt="Equipo médico en quirófano realizando una intervención"
        class="absolute inset-0 w-full h-full object-cover"
        width="1600"
        height="900"
        loading="lazy"
        decoding="async"
      />
      {/* Brand duotone tint */}
      <div class="absolute inset-0 bg-[#185FA5] mix-blend-color opacity-60"></div>
      {/* Cinematic fade to section bg */}
      <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-bg-dark)]/40 via-transparent to-[var(--color-bg-dark)]"></div>
      {/* Floating tag */}
      <div class="absolute bottom-6 left-6 sm:bottom-8 sm:left-10 inline-flex items-center gap-2 rounded-full bg-white/95 backdrop-blur-sm px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.18em] text-[var(--color-brand-700)] shadow-lg">
        <Icon name="tabler:stethoscope" class="h-3.5 w-3.5" />
        Tu carrera empieza acá
      </div>
    </div>
  </Reveal>

  <div class="container-page relative pt-16 pb-24 sm:pt-20 sm:pb-32">
    <div class="max-w-3xl mx-auto text-center">
      {/* Top mini-badge */}
      <Reveal>
        <div class="inline-flex items-center gap-2 rounded-full bg-white/8 border border-white/15 backdrop-blur-sm px-4 py-1.5 text-[11px] font-bold uppercase tracking-[0.18em] text-[var(--color-brand-200)]">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full rounded-full bg-[#10B981] opacity-75 animate-ping"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-[#10B981]"></span>
          </span>
          MENTOR CEAM
        </div>
      </Reveal>

      <Reveal delay={120}>
        <h2 class="mt-6 font-display text-3xl sm:text-5xl md:text-6xl font-extrabold leading-[1.05] tracking-tight text-white">
          Estudia con precisión.<br/>
          <span class="text-[var(--color-brand-200)]">Pregunta con libertad.</span><br/>
          Aprende con estrategia.
        </h2>
      </Reveal>

      <Reveal delay={220}>
        <div class="mt-12 flex flex-col items-center gap-5">
          <Button href="#" variant="primary" size="lg" shimmer class="!bg-white !text-[var(--color-brand-700)] hover:!bg-[var(--color-brand-50)]">
            Quiero acceder a MENTOR CEAM
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7" />
            </svg>
          </Button>

          {/* Trust line — sólo lenguaje del docx: "Pregúntale", "Curso VIP CEAM" */}
          <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-[13px] text-white/60">
            <span class="inline-flex items-center gap-1.5">
              <Icon name="tabler:books" class="h-4 w-4 text-[var(--color-brand-200)]" />
              Basado en libros de medicina
            </span>
            <span class="inline-flex items-center gap-1.5">
              <Icon name="tabler:brain" class="h-4 w-4 text-[var(--color-brand-200)]" />
              Active Recall + Spaced Repetition
            </span>
            <span class="inline-flex items-center gap-1.5">
              <Icon name="tabler:school" class="h-4 w-4 text-[var(--color-brand-200)]" />
              Curso VIP CEAM
            </span>
          </div>
        </div>
      </Reveal>
    </div>
  </div>
</section>
