---
import { Icon } from 'astro-icon/components';
---
<div data-chat class="relative tilt-3d">
  <div class="rounded-2xl overflow-hidden bg-white border border-[var(--color-border)] shadow-[0_30px_80px_-30px_rgba(4,44,83,0.35)]">
    {/* Browser frame */}
    <div class="flex items-center gap-1.5 px-4 py-3 bg-[var(--color-bg-secondary)] border-b border-[var(--color-border)]">
      <span class="h-2.5 w-2.5 rounded-full bg-[#FF5F57]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#FEBC2E]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#28C840]"></span>
      <div class="ml-3 h-6 flex-1 rounded-md bg-white border border-[var(--color-border)] flex items-center px-3">
        <span class="text-[11px] text-[var(--color-fg-subtle)] font-mono truncate">mentorceam.com / chat</span>
      </div>
    </div>

    {/* Chat header — comunidad CEAM como avatar grupal del chat */}
    <div class="flex items-center gap-3 px-5 py-3 bg-white border-b border-[var(--color-border)]">
      <div class="relative h-10 w-10 shrink-0 rounded-full overflow-hidden ring-2 ring-white shadow-[0_2px_8px_rgba(4,44,83,0.15)]">
        <img
          src="/assets/students-group.webp"
          alt="Comunidad CEAM"
          class="absolute inset-0 w-full h-full object-cover scale-110"
          width="80"
          height="80"
          loading="eager"
          decoding="async"
        />
        <div class="absolute inset-0 bg-[#185FA5] mix-blend-color opacity-40"></div>
        <span class="absolute -bottom-0.5 -right-0.5 h-3 w-3 rounded-full bg-[#10B981] ring-2 ring-white"></span>
      </div>
      <div class="flex-1 min-w-0">
        <p class="font-display font-bold text-[14px] text-[var(--color-fg)] leading-tight">
          MENTOR CEAM
        </p>
        <p class="mt-0.5 flex items-center gap-1.5 text-[11px] text-[var(--color-fg-muted)]">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-[#10B981]"></span>
          Comunidad CEAM · En línea
        </p>
      </div>
      <Icon name="tabler:dots-vertical" class="h-4 w-4 text-[var(--color-fg-subtle)] shrink-0" />
    </div>

    {/* Conversation — altura fija para evitar layout shift cuando el bot responde */}
    <div class="px-5 py-6 sm:px-6 sm:py-7 space-y-4 bg-white h-[460px] sm:h-[440px] overflow-y-auto">
      {/* USER MESSAGE */}
      <div data-chat-user class="chat-msg flex gap-3 justify-end">
        <div class="max-w-[78%] rounded-2xl rounded-tr-md bg-[var(--color-brand-500)] text-white px-4 py-3 text-[15px] leading-relaxed">
          Explícame el ciclo cardíaco paso a paso como para examen de residencia.
        </div>
        <div class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-[var(--color-bg-secondary)] border border-[var(--color-border)] text-[var(--color-fg-muted)]">
          <Icon name="tabler:user" class="h-5 w-5" />
        </div>
      </div>

      {/* TYPING DOTS */}
      <div data-chat-typing class="chat-msg is-hidden flex gap-3 justify-start">
        <img
          src="/assets/chatbot.png"
          alt="MENTOR CEAM"
          class="h-9 w-9 shrink-0 rounded-full object-cover bg-white ring-1 ring-[var(--color-border)]"
          width="36"
          height="36"
        />
        <div class="rounded-2xl rounded-tl-md bg-[var(--color-bg-secondary)] border border-[var(--color-border)] px-4 py-3 flex items-center gap-1 typing-dots">
          <span class="h-2 w-2 rounded-full bg-[var(--color-brand-500)] inline-block"></span>
          <span class="h-2 w-2 rounded-full bg-[var(--color-brand-500)] inline-block"></span>
          <span class="h-2 w-2 rounded-full bg-[var(--color-brand-500)] inline-block"></span>
        </div>
      </div>

      {/* BOT RESPONSE */}
      <div data-chat-bot class="chat-msg is-hidden flex gap-3 justify-start">
        <img
          src="/assets/chatbot.png"
          alt="MENTOR CEAM"
          class="h-9 w-9 shrink-0 rounded-full object-cover bg-white ring-1 ring-[var(--color-border)]"
          width="36"
          height="36"
        />
        <div class="max-w-[80%] rounded-2xl rounded-tl-md bg-[var(--color-bg-secondary)] border border-[var(--color-border)] px-4 py-3 text-[14.5px] leading-relaxed text-[var(--color-fg)]">
          <p class="font-semibold mb-2">Ciclo cardíaco — enfoque examen de residencia:</p>
          <ol class="space-y-1.5 list-decimal pl-4 text-[var(--color-fg-muted)]">
            <li><strong class="text-[var(--color-fg)]">Sístole auricular</strong> — contracción auricular, llenado ventricular final (~20%).</li>
            <li><strong class="text-[var(--color-fg)]">Contracción isovolumétrica</strong> — cierre válvulas AV (R1), presión ventricular sube.</li>
            <li><strong class="text-[var(--color-fg)]">Eyección ventricular</strong> — apertura válvulas semilunares, salida de sangre.</li>
            <li><strong class="text-[var(--color-fg)]">Relajación isovolumétrica</strong> — cierre semilunares (R2), inicio diástole.</li>
            <li><strong class="text-[var(--color-fg)]">Llenado ventricular</strong> — apertura AV, fase pasiva + activa.</li>
          </ol>
          <p class="mt-3 text-[13px] text-[var(--color-fg-subtle)]">Fuente: Guyton & Hall — Fisiología Médica.</p>
        </div>
      </div>
    </div>
  </div>

  {/* Floating decorative element */}
  <div class="absolute -top-4 -right-4 hidden sm:flex items-center gap-2 rounded-full bg-white border border-[var(--color-border)] px-3 py-1.5 shadow-lg">
    <span class="h-2 w-2 rounded-full bg-[#0F6E56]"></span>
    <span class="text-[11px] font-semibold text-[var(--color-fg-muted)]">IA médica activa</span>
  </div>
</div>
