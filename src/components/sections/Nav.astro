---
import Button from '../ui/Button.astro';
---
<header
  data-nav
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300 [&.is-scrolled]:bg-white/80 [&.is-scrolled]:backdrop-blur-lg [&.is-scrolled]:border-b [&.is-scrolled]:border-[var(--color-border)]"
>
  <nav class="container-page flex h-16 items-center justify-between">
    <a href="/" class="flex items-center group" aria-label="CEAM Medicina inicio">
      <img
        src="/assets/logo.png"
        alt="CEAM Medicina"
        class="h-12 sm:h-14 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
        width="220"
        height="80"
      />
    </a>

    <Button href="#cta" variant="primary" size="md" shimmer>
      Ingresar a MENTOR CEAM
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M13 5l7 7-7 7" />
      </svg>
    </Button>
  </nav>
</header>
