---
import Button from '../ui/Button.astro';
---
<header
  data-nav
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300 [&.is-scrolled]:bg-white/80 [&.is-scrolled]:backdrop-blur-lg [&.is-scrolled]:border-b [&.is-scrolled]:border-[var(--color-border)]"
>
  <nav class="container-page flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 group" aria-label="MENTOR CEAM inicio">
      <span class="grid h-9 w-9 place-items-center rounded-lg bg-[var(--color-brand-500)] text-white">
        {/* TODO: MENTOR CEAM logo asset pending — using inline stetoscopio glyph */}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 4v6a5 5 0 0 0 10 0V4" />
          <circle cx="18.5" cy="14.5" r="3" />
          <path d="M11 14v3a5.5 5.5 0 0 0 11 0v-2" />
        </svg>
      </span>
      <span class="font-display font-bold text-[15px] tracking-tight text-[var(--color-fg)]">
        MENTOR <span class="text-[var(--color-brand-500)]">CEAM</span>
      </span>
    </a>

    <Button href="#cta" variant="primary" size="md" shimmer>
      Ingresar a MENTOR CEAM
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M13 5l7 7-7 7" />
      </svg>
    </Button>
  </nav>
</header>
